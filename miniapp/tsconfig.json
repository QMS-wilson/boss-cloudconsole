{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules"],
    "types": ["miniprogram-api-typings"],
    "lib": ["ES2018"]
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules"]
}
